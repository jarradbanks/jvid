#!/usr/bin/env python3
"""Writes crates/jvid-app/assets/THIRD-PARTY-NOTICES.txt, which Help > About shows: every crate
in Cargo.lock with its licence and the licence files from its registry source, then whisper.cpp,
FFmpeg, the bundled fonts and the sample media. Rerun after Cargo.lock changes; a jvid-app test
fails while a locked crate is missing. Usage: scripts/gen-notices"""

import hashlib
import json
import re
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "crates/jvid-app/assets/THIRD-PARTY-NOTICES.txt"
FONTS = ROOT / "crates/suite-ui/assets"
# Standard texts, by SPDX id, for crates that publish no licence file.
STANDARD = ROOT / "crates/jvid-app/assets/notices"
LICENCE_FILE = re.compile(r"^(licen[cs]e|copying|notice|copyright)([-._].*)?$", re.I)
# Code a crate compiles in from a vendored tree, with that tree's own licence.
VENDORED = {
    "whisper-rs-sys": [("whisper.cpp (MIT)", "whisper.cpp/LICENSE")],
    "epaint_default_fonts": [
        ("egui fonts: Ubuntu (Ubuntu Font Licence 1.0)", "fonts/UFL.txt"),
        ("egui fonts: Noto Emoji (SIL Open Font License 1.1)", "fonts/OFL.txt"),
        ("egui fonts: Hack", "fonts/Hack-Regular.txt"),
        ("egui fonts: emoji-icon-font (MIT)", "fonts/emoji-icon-font-mit-license.txt"),
    ],
}

RULE = "=" * 78


def licence_files(pkg):
    """The texts of a crate's licence files, by file name."""
    root = Path(pkg["manifest_path"]).parent
    names = sorted(p.name for p in root.iterdir() if p.is_file() and LICENCE_FILE.match(p.name))
    if pkg.get("license_file") and Path(pkg["license_file"]).name not in names:
        names.append(pkg["license_file"])
    return [(n, (root / n).read_text(encoding="utf-8", errors="replace").strip()) for n in names]


def samples():
    """`LICENSES.toml`'s clips as dicts. shortcut: flat `key = "value"` lines only, since CI's
    Python has tomllib but 3.10 does not; swap for tomllib once 3.11 is the floor."""
    clips = []
    text = (ROOT / "crates/jvid-app/assets/samples/LICENSES.toml").read_text(encoding="utf-8")
    for line in text.splitlines():
        if line.strip() == "[[clip]]":
            clips.append({})
        elif m := re.match(r'^(\w+) = "(.*)"$', line):
            clips[-1][m[1]] = m[2]
    return clips


def main():
    meta = json.loads(
        subprocess.check_output(
            ["cargo", "metadata", "--format-version", "1", "--locked"], cwd=ROOT
        )
    )
    crates = sorted(
        (p for p in meta["packages"] if p["source"]), key=lambda p: (p["name"], p["version"])
    )
    texts = {}  # sha -> (number, text), so each distinct text is printed once
    index = []
    for p in crates:
        refs = []
        files = [t for _, t in licence_files(p)]
        if not files:
            ids = re.findall(r"[\w.+-]+", p["license"] or "")
            files = [(STANDARD / f"{i}.txt").read_text(encoding="utf-8").strip() for i in ids if (STANDARD / f"{i}.txt").exists()]
        for text in files:
            sha = hashlib.sha1(text.encode()).hexdigest()
            texts.setdefault(sha, (len(texts) + 1, text))
            refs.append(f"[{texts[sha][0]}]")
        index.append(f"{p['name']} {p['version']}: {p['license'] or 'see licence file'} {' '.join(refs)}".rstrip())

    out = [
        "jvid Third-Party Notices",
        "Generated by scripts/gen-notices; do not edit.",
        "",
        RULE,
        "FFmpeg",
        RULE,
        "jvid uses FFmpeg (https://ffmpeg.org), dynamically linked. Developer builds may use",
        "LGPL FFmpeg; release packages include GPL FFmpeg with x264/x265. The exact licence",
        "is reported by the linked runtime at startup. Packaged runtime-licenses/ contains",
        "its additional notices. FFmpeg source: https://ffmpeg.org/download.html. You may",
        "replace the FFmpeg libraries jvid loads with your own build. The LGPL and GPL",
        "licence texts follow; including these texts does not change jvid source's licence.",
        "",
        (STANDARD / "LGPL-2.1.txt").read_text(encoding="utf-8").strip(),
        "",
        (STANDARD / "GPL-2.0.txt").read_text(encoding="utf-8").strip(),
        "",
        (STANDARD / "GPL-3.0.txt").read_text(encoding="utf-8").strip(),
    ]
    for p in crates:
        if p["name"] in VENDORED:
            for title, path in VENDORED[p["name"]]:
                text = (Path(p["manifest_path"]).parent / path).read_text(encoding="utf-8").strip()
                out += ["", RULE, title, RULE, text]
    for title, file in [
        ("Inter (SIL Open Font License 1.1)", "Inter-LICENSE.txt"),
        ("Noto Sans CJK (SIL Open Font License 1.1)", "NotoSansCJK-LICENSE.txt"),
        ("Lucide icons (ISC)", "Lucide-LICENSE.txt"),
    ]:
        out += ["", RULE, title, RULE, (FONTS / file).read_text(encoding="utf-8").strip()]
    out += ["", RULE, "Sample Media", RULE]
    for c in samples():
        out += ["", f"{c['file']}: {c['title']}", f"  By {c['author']}, {c['licence']} ({c['licence_url']})"]
        out += [f"  Source: {c['source']}"] + ([f"  Changes: {c['changes']}"] if "changes" in c else [])
    out += ["", RULE, "Rust Crates", RULE, ""] + index
    for number, text in sorted(texts.values()):
        out += ["", f"--- [{number}] ---", text]
    OUT.write_text("\n".join(out) + "\n", encoding="utf-8")
    print(f"{OUT.relative_to(ROOT)}: {len(crates)} crates, {len(texts)} licence texts")


if __name__ == "__main__":
    main()
