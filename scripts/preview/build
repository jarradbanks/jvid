#!/usr/bin/env bash
# Regenerates docs/media/preview.webp and docs/media/preview.mp4: the README's preview video.
# Usage: scripts/preview/build   (needs the FFmpeg CLI with libx264 and libwebp, curl, Node 22+,
# and Mesa lavapipe or another Vulkan driver; see CONTRIBUTING.md for the build's own requirements)
#
# Downloads Tears of Steel (CC-BY 3.0, Blender Foundation) once into target/preview/, cuts four
# shots from it, has the reel test (crates/jvid-app/src/app/reel.rs) drive the real editor
# frame by frame through egui_kittest and wgpu, then lays that capture out with headlines and
# camera moves in scripts/preview/motion.html, rendered by HyperFrames. Footage stays in target/.
# HyperFrames downloads its own headless Chrome (it needs unzip); to use another Chrome or
# Chromium, set HYPERFRAMES_BROWSER_PATH to its binary.
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
cache="$root/target/preview"
media="$cache/media"
frames="$cache/frames"
src="$cache/tears_of_steel_720p.mov"
url=https://download.blender.org/demo/movies/ToS/tears_of_steel_720p.mov
sha=efa9062d9cdb7a338e40ad530dfdf234806743f29ae6a1a136b97ece4e588e8f
mkdir -p "$media"

ff() { ffmpeg -nostdin -hide_banner -loglevel error -y "$@"; }

if [ ! -f "$src" ]; then
  curl -fL --retry 8 --retry-delay 30 -C - -o "$src.part" "$url"
  mv "$src.part" "$src"
fi
echo "$sha  $src" | sha256sum -c --quiet

# name, start and length in seconds: whole shots, short GOPs so every seek is quick.
while read -r name start len; do
  ff -ss "$start" -i "$src" -t "$len" -c:v libx264 -preset slow -crf 16 -g 12 -pix_fmt yuv420p \
    -c:a aac -b:a 128k "$media/$name.mp4"
done <<'EOF'
bridge 26.0 3.5
walk 269.5 3.5
face 316.0 3.5
tower 438.7 2.4
EOF

rm -rf "$frames"
mkdir -p "$frames"
JVID_REEL_MEDIA="$media" JVID_REEL_FRAMES="$frames" LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 \
  cargo test --manifest-path "$root/Cargo.toml" -p jvid-app --lib app::reel -- --ignored --exact app::reel::reel

# The composition: the capture plus fonts, staged next to motion.html, rendered at 1920x1080.
motion="$cache/motion"
rm -rf "$motion"
mkdir -p "$motion"
cp "$root/scripts/preview/motion.html" "$motion/index.html"
cp "$root"/crates/suite-ui/assets/Inter-{Regular,Medium,SemiBold}.ttf "$motion/"
# Stills for the before/after wipe and the theme cards, by reel frame (seconds x 30): the
# frame before the grade, after it, then the Light, High Contrast and Dark themes.
while read -r name frame; do
  cp "$frames/$frame.png" "$motion/$name.png"
done <<'STILLS'
before 00117
after 00360
light 00945
hc 00975
dark 01020
STILLS
ff -framerate 30 -i "$frames/%05d.png" -c:v libx264 -preset slow -crf 10 -g 15 -pix_fmt yuv420p \
  "$motion/ui.mp4"
(cd "$motion" && HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1 HYPERFRAMES_SKIP_SKILLS=1 \
  npx -y hyperframes@0.8.143 render --fps 30 --quality high --crf 12 --video-frame-format png \
  --workers 1 -o render.mp4)

# The composition ends on its first frame, so both files loop without a cut. The camera moves
# change every pixel, so the webp drops to 15 fps at 880 wide (GitHub's README column) to stay
# under 4 MB. Below quality ~75, WebP leaves stale blocks on the dark background.
out="$root/docs/media"
mkdir -p "$out"
ff -i "$motion/render.mp4" -filter_complex "split[a][b];[a]format=yuv420p[mp4];[b]fps=15,scale=880:-1:flags=lanczos[webp]" \
  -map '[mp4]' -c:v libx264 -preset veryslow -crf 20 -movflags +faststart -an "$out/preview.mp4" \
  -map '[webp]' -c:v libwebp_anim -lossless 0 -preset picture -quality 78 -compression_level 6 -loop 0 -an \
  "$out/preview.webp"
ls -l "$out/preview.mp4" "$out/preview.webp"
